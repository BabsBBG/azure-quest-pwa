{
  "name": "praxisgrid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:integration": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project=mobile-390 --project=mobile-320",
    "test:accessibility": "playwright test --grep @accessibility",
    "test:visual": "playwright test --grep @visual",
    "test:production-smoke": "node scripts/run-production-smoke.mjs",
    "validate:harness": "node scripts/validate-harness.mjs",
    "validate:routes": "node scripts/check-routes.mjs",
    "validate:questions": "node scripts/validate-question-bank.mjs",
    "validate:duplicates": "node scripts/validate-duplicates.mjs",
    "validate:source-grounding": "node scripts/validate-source-grounding.mjs",
    "validate:source-ingestion": "node scripts/validate-source-ingestion.mjs",
    "validate:knowledge-graph": "node scripts/validate-knowledge-graph.mjs",
    "validate:learning-summaries": "node scripts/validate-learning-summaries.mjs",
    "validate:question-generation": "node scripts/validate-question-generation-factory.mjs",
    "validate:content-orchestration": "node scripts/validate-content-orchestration.mjs",
    "validate:question-critic": "node scripts/validate-question-critic.mjs",
    "validate:source-impact": "node scripts/validate-source-impact.mjs",
    "validate:admin-review-studio": "node scripts/validate-admin-review-studio.mjs",
    "validate:curated-domain-quizzes": "node scripts/validate-curated-domain-quizzes.mjs",
    "validate:finite-runs": "node scripts/validate-finite-certification-runs.mjs",
    "validate:content-quality-reports": "node scripts/validate-content-quality-reports.mjs",
    "validate:authorization": "node scripts/validate-authorization.mjs",
    "validate:rich-items": "node scripts/validate-rich-items.mjs",
    "validate:github-import-controls": "node scripts/validate-github-import-controls.mjs",
    "validate:active-interview-recovery": "node scripts/validate-active-interview-recovery.mjs",
    "validate:auth-first-ia": "node scripts/validate-auth-first-ia.mjs",
    "validate:assessment-shell": "node scripts/validate-assessment-shell.mjs",
    "validate:project-fixtures": "node scripts/validate-project-fixtures.mjs",
    "validate:project-intelligence": "node scripts/validate-project-intelligence.mjs",
    "validate:privacy-workflows": "node scripts/validate-privacy-workflows.mjs",
    "validate:typography": "node scripts/validate-typography.mjs",
    "validate:production-smoke-gate": "node scripts/validate-production-smoke-gate.mjs",
    "check:routes": "node scripts/check-routes.mjs"
  },
  "dependencies": {
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/supabase-js": "^2.110.4",
    "@vite-pwa/assets-generator": "^1.0.0",
    "canvas-confetti": "^1.9.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.18.1",
    "localforage": "^1.10.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.10"
  }
}
